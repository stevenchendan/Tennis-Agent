# 复制为 .env（或直接设置同名环境变量，前缀 TENNIS_）

# --- full 模式（分析真实视频）---------------------------------------------
# 网球检测 YOLO 权重（必需，ultralytics 格式）
TENNIS_BALL_MODEL_PATH=models/last.pt
# 球场关键点权重（可选；缺省使用代理映射并降级标注）
TENNIS_COURT_MODEL_PATH=models/keypoints_model.pth
# 球员检测模型（缺省 yolov8n）
TENNIS_PLAYER_MODEL_PATH=yolov8n.pt

# --- LLM（可选；缺省为确定性规则报告/问答）--------------------------------
TENNIS_OPENAI_API_KEY=
# 代理/网关地址（可选）
# TENNIS_OPENAI_BASE_URL=https://your-gateway/v1
TENNIS_LLM_MODEL=gpt-4o-mini

# --- 检测阈值（可选，一般不用动）-------------------------------------------
TENNIS_PLAYER_CONF=0.5
TENNIS_BALL_CONF=0.15
